:root {
  --site-primary: #315c4c;
  --site-on-primary: #ffffff;
  --site-secondary: #e8bd72;
  --site-on-secondary: #332719;
  --site-background: #f4f2e9;
  --site-on-background: #24332d;
  --site-font-body: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --site-font-heading: Georgia, "Times New Roman", serif;
  --site-heading-scale: 1;
  --site-spacing-scale: 1;
  --site-radius-scale: 1;
  --site-decoration-opacity: 1;
  color-scheme: light dark;
  --surface: light-dark(#fffefa, #202a26);
  --surface-soft: light-dark(#eeeee5, #293630);
  --text: light-dark(#24332d, #edf2ed);
  --muted: light-dark(#718078, #aab8af);
  --line: light-dark(#e2e5dc, #3b4941);
  --good: #287a55;
  --bad: #b64d45;
  --shadow: 0 12px 34px rgba(32, 48, 39, .07);
}
* { box-sizing: border-box; }
body { margin: 0; font-family: var(--site-font-body); background: var(--site-background); color: var(--text); }
button, input, select { font: inherit; }
button { cursor: pointer; }
#app { min-height: 100vh; width: 100%; background-color: var(--site-background); color: var(--site-on-background); border-radius: 0; }
.topbar { background: var(--site-primary); color: var(--site-on-primary); padding: calc(18px * var(--site-spacing-scale)) max(22px, calc((100vw - 1180px)/2)); display:flex; justify-content:space-between; align-items:center; gap:16px; }
.brand { display:flex; align-items:center; gap:12px; }
.brand-mark { width:42px; height:42px; border-radius:14px; background:var(--site-secondary); color:var(--site-on-secondary); display:grid; place-items:center; font-size:22px; font-weight:800; }
.brand h1 { margin:0; font-family:var(--site-font-heading); font-size:calc(25px * var(--site-heading-scale)); letter-spacing:-.5px; }
.brand small { display:block; color:rgba(255,255,255,.72); font-size:11px; letter-spacing:1.5px; text-transform:uppercase; margin-top:2px; }
.top-actions { display:flex; align-items:center; gap:10px; color:rgba(255,255,255,.82); font-size:12px; }
.pill { border:1px solid rgba(255,255,255,.28); border-radius:999px; padding:8px 12px; }
main { max-width:1180px; margin:0 auto; padding:30px 22px 60px; }
.welcome { display:flex; justify-content:space-between; align-items:end; gap:18px; margin-bottom:23px; }
.eyebrow { color:var(--good); text-transform:uppercase; letter-spacing:1.7px; font-weight:800; font-size:10px; }
h2 { font-family:var(--site-font-heading); font-size:calc(30px * var(--site-heading-scale)); font-weight:600; margin:5px 0 4px; color:var(--text); }
.sub { color:var(--muted); font-size:13px; margin:0; }
.date-label { color:var(--muted); font-size:12px; }
.summary-grid { display:grid; grid-template-columns:1.35fr 1fr 1fr; gap:14px; margin-bottom:18px; }
.summary-card { background:var(--surface); border:1px solid var(--line); border-radius:calc(18px * var(--site-radius-scale)); padding:20px; box-shadow:var(--shadow); }
.summary-card.primary { background:var(--site-primary); color:var(--site-on-primary); border-color:transparent; }
.card-label { font-size:11px; text-transform:uppercase; letter-spacing:1.2px; opacity:.72; font-weight:700; }
.amount { font-size:clamp(25px, 3vw, 36px); font-weight:750; letter-spacing:-1.4px; margin:9px 0 5px; font-variant-numeric:tabular-nums; }
.card-note { font-size:11px; opacity:.72; }
.summary-icon { float:right; font-size:22px; opacity:.8; }
.actions-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:18px; }
.panel { background:var(--surface); border:1px solid var(--line); border-radius:calc(18px * var(--site-radius-scale)); padding:21px; box-shadow:var(--shadow); min-width:0; }
.panel-head { display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:16px; }
.panel h3 { font-size:15px; margin:0; color:var(--text); }
.panel-desc { color:var(--muted); font-size:11px; margin-top:4px; }
.tag { background:var(--surface-soft); color:var(--muted); padding:6px 9px; border-radius:999px; font-size:10px; white-space:nowrap; }
form .field-grid { display:grid; grid-template-columns:1fr 1fr; gap:11px; }
.field { display:flex; flex-direction:column; gap:6px; margin-bottom:11px; }
.field.full { grid-column:1/-1; }
label { font-size:11px; font-weight:700; color:var(--muted); }
input, select { width:100%; min-width:0; border:1px solid var(--line); background:var(--surface); color:var(--text); border-radius:10px; padding:10px 11px; outline:none; font-size:12px; }
input:focus, select:focus { border-color:var(--site-primary); box-shadow:0 0 0 3px color-mix(in srgb, var(--site-primary) 13%, transparent); }
.btn { border:0; border-radius:10px; padding:11px 15px; font-size:12px; font-weight:750; transition:transform .15s, opacity .15s; }
.btn:hover { transform:translateY(-1px); }
.btn-primary { background:var(--site-primary); color:var(--site-on-primary); }
.btn-secondary { background:var(--site-secondary); color:var(--site-on-secondary); }
.btn-quiet { background:var(--surface-soft); color:var(--text); }
.btn-danger { background:#f8e7e4; color:#9b3f37; }
.btn-block { width:100%; }
.category-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; }
.category-card { border:1px solid var(--line); border-radius:14px; padding:14px; background:var(--surface); min-width:0; }
.category-top { display:flex; align-items:center; justify-content:space-between; gap:6px; }
.category-icon { width:31px; height:31px; display:grid; place-items:center; border-radius:10px; background:var(--surface-soft); font-size:16px; }
.category-percent { font-size:10px; color:var(--muted); font-weight:700; }
.category-name { font-size:11px; color:var(--muted); margin:11px 0 4px; min-height:27px; }
.category-balance { font-size:18px; font-weight:800; letter-spacing:-.5px; font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }
.progress { height:5px; border-radius:99px; background:var(--surface-soft); overflow:hidden; margin-top:11px; }
.progress span { display:block; height:100%; border-radius:99px; background:var(--site-primary); }
.category-foot { display:flex; justify-content:space-between; color:var(--muted); font-size:9px; margin-top:6px; }
.section { margin-top:18px; }
.two-col { display:grid; grid-template-columns:1.1fr .9fr; gap:16px; }
.inline-form { display:grid; grid-template-columns:1.2fr .8fr .7fr auto; gap:8px; align-items:end; }
.inline-form .field { margin:0; }
.priority-list { display:flex; flex-direction:column; gap:9px; }
.priority-item { border:1px solid var(--line); border-radius:12px; padding:11px 12px; display:flex; align-items:center; gap:10px; }
.priority-item.done { opacity:.55; }
.priority-item.done .buy-name { text-decoration:line-through; }
.priority-check { width:17px; height:17px; accent-color:var(--site-primary); flex:0 0 auto; }
.buy-info { min-width:0; flex:1; }
.buy-name { font-size:12px; font-weight:750; overflow-wrap:anywhere; }
.buy-meta { font-size:10px; color:var(--muted); margin-top:3px; }
.buy-price { font-size:12px; font-weight:800; white-space:nowrap; }
.priority-badge { font-size:9px; border-radius:99px; padding:4px 7px; background:var(--surface-soft); color:var(--muted); }
.icon-btn { border:0; background:transparent; color:var(--muted); padding:5px; font-size:14px; }
.table-wrap { overflow-x:auto; }
table { width:100%; border-collapse:collapse; min-width:520px; }
th, td { text-align:left; padding:11px 9px; border-bottom:1px solid var(--line); font-size:11px; }
th { color:var(--muted); font-size:9px; text-transform:uppercase; letter-spacing:1px; }
td strong { font-size:11px; }
.type-income { color:var(--good); font-weight:800; }
.type-expense { color:var(--bad); font-weight:800; }
.empty { color:var(--muted); text-align:center; padding:25px 10px; font-size:12px; }
.report-actions { display:flex; flex-wrap:wrap; gap:8px; }
.report-note { color:var(--muted); font-size:11px; line-height:1.6; margin:0 0 14px; }
.toast { position:fixed; bottom:22px; left:50%; transform:translate(-50%,20px); opacity:0; pointer-events:none; background:#263a30; color:white; padding:11px 16px; border-radius:10px; font-size:12px; box-shadow:var(--shadow); transition:.25s; z-index:10; }
.toast.show { opacity:1; transform:translate(-50%,0); }
.section-toggle { display:flex; align-items:center; justify-content:space-between; gap:12px; width:100%; text-align:left; }
.section-toggle .toggle-copy { display:flex; flex-direction:column; gap:4px; }
.section-toggle .toggle-title { font-size:14px; font-weight:800; }
.section-toggle .toggle-desc { color:var(--muted); font-size:11px; font-weight:400; }
.toggle-arrow { font-size:16px; transition:transform .2s; }
.section-toggle[aria-expanded="true"] .toggle-arrow { transform:rotate(180deg); }
.collapsible-content[hidden] { display:none!important; }
.summary-grid.compact { margin:0 0 16px; }
.summary-grid.compact .summary-card { box-shadow:none; }
.wish-category-tabs { display:flex; flex-wrap:wrap; gap:7px; margin:14px 0; }
.wish-category-tabs button { border:1px solid var(--line); border-radius:999px; padding:7px 11px; background:var(--surface-soft); color:var(--text); font-size:10px; font-weight:750; }
.wish-category-tabs button.active { background:var(--site-primary); border-color:var(--site-primary); color:white; }
.wish-group { margin-top:13px; }
.wish-group-title { display:flex; justify-content:space-between; align-items:center; font-size:11px; font-weight:800; margin:0 0 8px; color:var(--text); }
.wish-group-title span { color:var(--muted); font-size:10px; font-weight:600; }
@media print { .collapsible-content[hidden] { display:block!important; } .section-toggle, .wish-category-tabs { display:none!important; } }
.footer { text-align:center; color:var(--muted); font-size:10px; padding:20px; }
@media(max-width:850px) { .summary-grid{grid-template-columns:1fr 1fr}.summary-card.primary{grid-column:1/-1}.category-grid{grid-template-columns:repeat(2,1fr)}.two-col{grid-template-columns:1fr} }
@media(max-width:600px) { main{padding:22px 14px 40px}.topbar{padding:14px}.top-actions .pill{display:none}.welcome{align-items:start;flex-direction:column}.summary-grid,.actions-grid{grid-template-columns:1fr}.summary-card.primary{grid-column:auto}.inline-form{grid-template-columns:1fr 1fr}.inline-form .field:first-child{grid-column:1/-1}.inline-form button{grid-column:1/-1}.category-grid{gap:9px}.panel{padding:16px}.brand h1{font-size:22px} }
@media print { body{background:white!important;color:#111!important}.topbar{background:#315c4c!important;print-color-adjust:exact}.no-print, .actions-grid, #shoppingPanel, .footer{display:none!important} main{padding:10px;max-width:none}.panel,.summary-card,.category-card{box-shadow:none;break-inside:avoid}.summary-grid{grid-template-columns:repeat(3,1fr)}.category-grid{grid-template-columns:repeat(4,1fr)} }
</style>

<meta name="theme-color" content="#315c4c">
<meta name="description" content="PesoPlan — a thoughtful personal budget tracker.">
<link rel="manifest" href="manifest.webmanifest">
<link rel="apple-touch-icon" href="icons/icon-192.png">
<script src="supabase-config.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
.cloud-account-btn { border:1px solid rgba(255,255,255,.35); background:transparent; color:white; border-radius:999px; padding:8px 12px; font-size:11px; font-weight:700; }
.cloud-account-btn:hover { background:rgba(255,255,255,.12); }
.cloud-modal { position:fixed; inset:0; z-index:30; background:rgba(15,25,20,.58); display:grid; place-items:center; padding:18px; }
.cloud-modal[hidden] { display:none!important; }
.cloud-dialog { width:min(100%,430px); background:var(--surface); color:var(--text); border:1px solid var(--line); border-radius:18px; padding:22px; box-shadow:0 24px 70px rgba(0,0,0,.22); }
.cloud-dialog h3 { margin:0 0 6px; font-family:var(--site-font-heading); font-size:23px; }
.cloud-dialog p { color:var(--muted); font-size:12px; line-height:1.6; margin:0 0 16px; }
.cloud-dialog .field { margin-bottom:12px; }
.cloud-dialog-actions { display:grid; grid-template-columns:1fr 1fr; gap:9px; margin-top:14px; }
.cloud-dialog .cloud-status { margin-top:12px; min-height:18px; font-size:11px; color:var(--muted); }
.cloud-dialog .close-cloud { float:right; border:0; background:transparent; color:var(--muted); font-size:20px; cursor:pointer; }
#cloudAccountSummary { font-size:11px; color:var(--muted); overflow-wrap:anywhere; margin:10px 0; }
@media(max-width:600px) { .cloud-account-btn { padding:7px 9px; font-size:10px; } }
